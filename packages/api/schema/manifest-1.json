{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baron.dev/schema/manifest-1.json",
  "title": "Baron plugin manifest, apiVersion 1",
  "description": "manifest.json at the root of a Baron plugin package. Baron's Swift validator mirrors this schema and adds checks a schema can't express.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "apiVersion",
    "main",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
      "description": "Reverse-DNS, lowercase, unique; never changes between versions."
    },
    "name": {
      "$ref": "#/$defs/label",
      "maxLength": 100,
      "type": "string"
    },
    "description": {
      "$ref": "#/$defs/label",
      "maxLength": 500,
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "apiVersion": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "defaultLocale": {
      "$ref": "#/$defs/locale"
    },
    "main": {
      "$ref": "#/$defs/path",
      "pattern": "\\.js$",
      "type": "string"
    },
    "icon": {
      "$ref": "#/$defs/svgPath"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "macos",
          "windows",
          "linux"
        ]
      }
    },
    "minBaronVersion": {
      "$ref": "#/$defs/version"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "optionalPermissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/permission"
          },
          {
            "const": "network:*"
          }
        ]
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preference"
      }
    },
    "settingsPage": {
      "$ref": "#/$defs/path",
      "pattern": "\\.html$",
      "type": "string"
    },
    "settingsView": {
      "$ref": "#/$defs/identifier"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
      "description": "A JavaScript identifier: action, preference and handler names."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Text shown to users, or %key% looked up in locales/."
    },
    "text": {
      "type": "string",
      "maxLength": 500,
      "description": "Text shown to users, or %key% looked up in locales/; may be empty."
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "A BCP 47 language tag, such as zh-Hans."
    },
    "path": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!(?:.*/)?\\.{1,2}(?:/|$))(?:[A-Za-z0-9_@.-]+/)*[A-Za-z0-9_@.-]+$",
      "description": "A path inside the package: relative, no . or .. segments."
    },
    "svgPath": {
      "$ref": "#/$defs/path",
      "pattern": "\\.svg$",
      "type": "string"
    },
    "permission": {
      "anyOf": [
        {
          "enum": [
            "context.sentence",
            "context.paragraph",
            "context.page",
            "context.window",
            "clipboard.read",
            "selection.replace",
            "secrets",
            "code.dynamic"
          ]
        },
        {
          "type": "string",
          "pattern": "^network:(?:https?://)?(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*|\\[[0-9a-f:.]+\\])(?::[0-9]{1,5})?$"
        }
      ]
    },
    "appMatch": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "macos": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "windows": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "linux": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "regex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "contentTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "word",
              "url",
              "email",
              "number",
              "text"
            ]
          }
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/appMatch"
          }
        },
        "excludeApps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/appMatch"
          }
        },
        "editable": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "run": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/label",
          "maxLength": 100,
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/svgPath"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sentence",
              "paragraph",
              "page",
              "window"
            ]
          }
        },
        "autoRun": {
          "enum": [
            "allowed",
            "never"
          ]
        }
      }
    },
    "preferenceOption": {
      "type": "object",
      "required": [
        "value",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/label",
          "type": "string",
          "maxLength": 100
        },
        "subtitle": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "preference": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "checkbox",
            "dropdown",
            "checklist",
            "list",
            "secret",
            "file",
            "directory",
            "app",
            "button",
            "heading"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string"
              },
              "placeholder": {
                "$ref": "#/$defs/text"
              },
              "multiline": {
                "type": "boolean"
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "checkbox"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "boolean"
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "dropdown"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string"
              },
              "dependsOn": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "options"
                ],
                "properties": {
                  "options": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/preferenceOption"
                    }
                  }
                }
              },
              {
                "required": [
                  "optionsFrom"
                ],
                "properties": {
                  "optionsFrom": {
                    "$ref": "#/$defs/identifier"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "checklist"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "dependsOn": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "options"
                ],
                "properties": {
                  "options": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/preferenceOption"
                    }
                  }
                }
              },
              {
                "required": [
                  "optionsFrom"
                ],
                "properties": {
                  "optionsFrom": {
                    "$ref": "#/$defs/identifier"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "itemPlaceholder": {
                "$ref": "#/$defs/text"
              },
              "itemPattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "secret"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "placeholder": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "file"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "extensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+$"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "directory"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "app"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "required": [
              "run",
              "label"
            ],
            "properties": {
              "run": {
                "$ref": "#/$defs/identifier"
              },
              "label": {
                "$ref": "#/$defs/label",
                "type": "string",
                "maxLength": 100
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "heading"
              }
            }
          },
          "then": {
            "properties": {}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
