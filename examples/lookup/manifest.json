{
    "$schema": "../../packages/api/schema/manifest-1.json",
    "id": "org.baron.example.lookup",
    "name": "Define",
    "description": "Shows a short English–Chinese definition of the selected word, from Youdao's dictionary.",
    "version": "1.0.0",
    "apiVersion": 1,
    "author": "Baron",
    "license": "MIT",
    "homepage": "https://dict.youdao.com",
    "main": "dist/main.js",
    "permissions": [
        "network:dict.youdao.com"
    ],
    "actions": [
        {
            "id": "define",
            "title": "Define",
            "when": {
                "contentTypes": [
                    "word"
                ],
                "maxLength": 40
            },
            "autoRun": "allowed"
        }
    ]
}
