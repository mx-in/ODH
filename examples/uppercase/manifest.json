{
    "$schema": "../../packages/api/schema/manifest-1.json",
    "id": "org.baron.example.uppercase",
    "name": "Uppercase",
    "description": "Turns the selected text into capitals.",
    "version": "1.0.0",
    "apiVersion": 1,
    "author": "Baron",
    "license": "MIT",
    "main": "dist/main.js",
    "permissions": ["selection.replace"],
    "actions": [
        {
            "id": "uppercase",
            "title": "UPPERCASE",
            "when": { "editable": true, "maxLength": 10000 }
        }
    ]
}
