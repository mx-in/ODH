{
    "compilerOptions": {
        "target": "ES2023",
        "lib": [
            "ES2023"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "bun"
        ],
        "allowImportingTsExtensions": true
    },
    "include": [
        "src",
        "test"
    ]
}
